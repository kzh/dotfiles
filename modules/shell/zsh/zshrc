# Resolve through the installed symlink so sibling files work before reinstalling.
export DOTFILES="${${(%):-%N}:A:h:h:h:h}"
source "$DOTFILES/modules/shell/zsh/zprofile"

# Installed completions and Oh My Zsh provide the standard shell conveniences.
typeset -U fpath
[[ -d "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions" ]] &&
  fpath=("${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions" $fpath)
mkdir -p "$XDG_CACHE_HOME/zsh"
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=robbyrussell
ZSH_CACHE_DIR="$XDG_CACHE_HOME/zsh"
ZSH_COMPDUMP="$ZSH_CACHE_DIR/zcompdump-$ZSH_VERSION"
DISABLE_UNTRACKED_FILES_DIRTY=true
zstyle ':omz:update' mode disabled
plugins=(git history-substring-search zsh-autosuggestions fast-syntax-highlighting)
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit
  compinit -d "$ZSH_COMPDUMP"
  PROMPT='%F{cyan}%1~%f %# '
fi

HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY SHARE_HISTORY HIST_IGNORE_SPACE HIST_IGNORE_ALL_DUPS
setopt HIST_EXPIRE_DUPS_FIRST HIST_SAVE_NO_DUPS HIST_FCNTL_LOCK
unsetopt INC_APPEND_HISTORY INC_APPEND_HISTORY_TIME FLOW_CONTROL
setopt AUTO_CD INTERACTIVE_COMMENTS NO_BEEP
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

if (( $+functions[history-substring-search-up] )); then
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
  bindkey '^P' history-substring-search-up
  bindkey '^N' history-substring-search-down
fi

# Let each tool own its shell integration; Atuin gets Ctrl-R after fzf.
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
# Rosé Pine Dawn, shared with the terminal and editor.
export FZF_DEFAULT_OPTS='--height=60% --layout=reverse --border --color=light
  --color=fg:#797593,fg+:#575279,bg:#faf4ed,bg+:#f2e9de
  --color=hl:#d7827e,hl+:#d7827e,info:#56949f,marker:#b4637a
  --color=prompt:#286983,spinner:#ea9d34,pointer:#907aa9,header:#907aa9
  --color=border:#9893a5,gutter:#faf4ed'
command -v fzf >/dev/null && eval "$(fzf --zsh)"
command -v atuin >/dev/null && eval "$(atuin init zsh --disable-up-arrow)"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

command -v fnm >/dev/null && eval "$(fnm env --use-on-cd --shell zsh)"
[[ -r "$HOME/.orbstack/shell/init.zsh" ]] && source "$HOME/.orbstack/shell/init.zsh"
source "$DOTFILES/modules/shell/zsh/aliases.zsh"

[[ -x "$XDG_CONFIG_HOME/tmux/scripts/tmux-sessionizer" ]] &&
  bindkey -s '^f' "${(q)XDG_CONFIG_HOME}/tmux/scripts/tmux-sessionizer\n"
[[ -r "$XDG_CONFIG_HOME/zsh/local.zsh" ]] && source "$XDG_CONFIG_HOME/zsh/local.zsh"
