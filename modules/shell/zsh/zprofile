# Shared by login shells and interactive non-login shells.
if [[ -z "${HOMEBREW_PREFIX:-}" ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export EDITOR=nvim VISUAL=nvim
export LANG="${LANG:-en_US.UTF-8}"
export PAGER=less LESS='-R -i' LESSCHARSET=utf-8
export GOPATH="$HOME/Code/Go" GOBIN="$HOME/Code/Go/bin"
export BUN_INSTALL="$HOME/.bun"
export PULUMI_SKIP_UPDATE_CHECK=true
[[ -t 1 ]] && export GPG_TTY="$(tty)"

typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.cargo/bin" "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/rustup/bin"
  "${HOMEBREW_PREFIX:-/opt/homebrew}/bin" "${HOMEBREW_PREFIX:-/opt/homebrew}/sbin"
  "$GOBIN" "$BUN_INSTALL/bin" $path)
for bin_dir in "$HOME/Code/google-cloud-sdk/bin" "$HOME/.lmstudio/bin" \
  "$HOME/.codeium/windsurf/bin" /Applications/Obsidian.app/Contents/MacOS; do
  [[ -d "$bin_dir" ]] && path+=("$bin_dir")
done
unset bin_dir
