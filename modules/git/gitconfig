[core]
	editor = nvim
	pager = delta
	excludesfile = ~/.gitignore_global
	autocrlf = input
	whitespace = cr-at-eol

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true
	autoSquash = true

[merge]
	conflictStyle = zdiff3

[diff]
	algorithm = histogram
	colorMoved = default

[delta]
	navigate = true
	light = true
	side-by-side = false
	line-numbers = true
	syntax-theme = "base16"
	plus-style = "syntax #d7dfd7"
	minus-style = "syntax #f4ede8"
	line-numbers-left-style = "#797593"
	line-numbers-right-style = "#797593"

[interactive]
	diffFilter = delta --color-only

[help]
	autocorrect = prompt

[rerere]
	enabled = true

[column]
	ui = auto

[branch]
	sort = -committerdate

[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

# Keep identity and signing settings machine-local. This include stays last so
# local values can intentionally override any tracked defaults above.
[include]
	path = ~/.gitconfig.local
