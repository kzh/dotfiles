#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ./install [--minimal] [-y|--yes] [-h|--help]

Install macOS dotfile configuration, backing up existing files.
  --minimal  Install only Zsh, tmux, Neovim, Atuin defaults, and the eza theme.
  -y, --yes  Skip the confirmation prompt.

For minimal configuration, packages, and shell/tmux plugin setup: just minimal
EOF
}

assume_yes=0
minimal=0
for arg in "$@"; do
    case "$arg" in
        --minimal) minimal=1 ;;
        -y|--yes) assume_yes=1 ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown option: %s\n' "$arg" >&2; usage >&2; exit 2 ;;
    esac
done
if [[ "$OSTYPE" != darwin* ]]; then
    printf 'This dotfiles repo targets macOS only.\n' >&2
    exit 1
fi
if [[ "$assume_yes" == 0 ]]; then
    read -r -p 'Install configuration (existing files will be backed up)? [y/N] ' answer || exit 0
    [[ "$answer" == [yY] ]] || exit 0
fi

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
home_dir="$(cd "$HOME" && pwd -P)"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
atuin_config_dir="${ATUIN_CONFIG_DIR:-$config_dir/atuin}"
backup_dir="$HOME/.dotfiles_backup/$(date +%Y%m%d_%H%M%S)_$$"

prepare_target() {
    local target="$1" parent backup
    # Check the nearest existing parent before creating directories or moving files.
    case "$target/" in
        */../*|*/./*) printf 'Refusing ambiguous target: %s\n' "$target" >&2; exit 1 ;;
    esac
    [[ "$target" == "$HOME/"* ]] || { printf 'Target must be under HOME: %s\n' "$target" >&2; exit 1; }
    parent="$(dirname "$target")"
    while [[ ! -e "$parent" && ! -L "$parent" ]]; do
        parent="$(dirname "$parent")"
    done
    parent="$(cd "$parent" && pwd -P)"
    if [[ "$parent/" != "$home_dir/"* ]]; then
        printf 'Refusing target through a directory outside HOME: %s\n' "$target" >&2
        exit 1
    fi
    mkdir -p "$(dirname "$target")"
    if [[ -e "$target" || -L "$target" ]]; then
        backup="$backup_dir/${target#"$HOME/"}"
        mkdir -p "$(dirname "$backup")"
        mv "$target" "$backup"
        printf 'Backed up: %s\n' "$target"
    fi
}

install_file() {
    local source="$repo_dir/$1" target="$2" mode="${3:-link}"
    [[ -e "$source" ]] || { printf 'Missing source: %s\n' "$source" >&2; exit 1; }
    case "$mode" in
        link) [[ ! -L "$target" || "$(readlink "$target")" != "$source" ]] || return 0 ;;
        copy)
            if [[ -f "$target" && ! -L "$target" ]] && cmp -s "$source" "$target"; then
                return 0
            fi
            ;;
        template) [[ ! -e "$target" && ! -L "$target" ]] || return 0 ;;
    esac
    prepare_target "$target"
    if [[ "$mode" == link ]]; then
        ln -s "$source" "$target"
    else
        cp "$source" "$target"
        [[ "$mode" != template ]] || chmod 600 "$target"
    fi
    printf 'Installed: %s\n' "$target"
}

# Copy entrypoints so third-party installers cannot append to tracked files.
install_file home/.zshrc "$HOME/.zshrc" copy
install_file home/.zprofile "$HOME/.zprofile" copy

# Local overrides must live in a real directory outside the tracked module tree.
if [[ -L "$config_dir/zsh" || ! -d "$config_dir/zsh" ]]; then
    prepare_target "$config_dir/zsh"
    mkdir -p "$config_dir/zsh"
fi
for file in zshrc zprofile aliases.zsh; do
    install_file "modules/shell/zsh/$file" "$config_dir/zsh/$file"
done
install_file modules/shell/zsh/local.zsh.example "$config_dir/zsh/local.zsh" template

install_file home/.tmux.conf "$HOME/.tmux.conf"
install_file modules/terminal/tmux "$config_dir/tmux"
install_file modules/editor/nvim "$config_dir/nvim"
install_file modules/cli/eza/theme.yml "$HOME/Library/Application Support/eza/theme.yml"
install_file modules/cli/atuin/config.toml "$atuin_config_dir/config.toml" template

if [[ "$minimal" == 0 ]]; then
    install_file modules/terminal/ghostty/config "$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
    install_file modules/cli/uv/uv.toml "$config_dir/uv/uv.toml"
    install_file modules/git/gitconfig "$HOME/.gitconfig"
    install_file modules/git/gitignore_global "$HOME/.gitignore_global"
    install_file modules/git/gitconfig.local.example "$HOME/.gitconfig.local" template
fi

printf 'Configuration installed. Restart your terminal to load it.\n'
[[ ! -d "$backup_dir" ]] || printf 'Backups: %s\n' "$backup_dir"
if [[ "$minimal" == 1 ]]; then
    printf 'Packages and plugins: just brew-minimal; just plugins\n'
else
    printf 'Packages and plugins: just brew; just plugins\n'
fi
